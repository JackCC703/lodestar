{
  "name": "Lodestar devnet",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/node:1": {"version": "26"},
    "ghcr.io/devcontainers-extra/features/zig:1": {"version": "0.16.0"}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "docker info >/dev/null && echo docker ok || echo docker missing"
}
